<Window x:Class="PL.Windows.ProcessingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Weiterverarbeitung"
        Height="500"
        Width="600"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- Style für runde Buttons -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF1B1F1F"/>
            <!-- Normal -->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property = "Height" Value="25"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    CornerRadius="5"
                    SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover-Effekt -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF2D2C2C"/>
                                <!-- Hover-Farbe -->
                            </Trigger>

                            <!-- Klick-Effekt -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF2D2C2C"/>
                                <!-- Klick-Farbe -->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style für runde TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="5"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimaler Style: NUR abgerundete Ecken für ComboBox -->
        <Style TargetType="ComboBox">
            <!-- Grundwerte wie bei deiner TextBox -->
            <Setter Property="Padding" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <!-- Äußerer Rahmen mit runden Ecken -->
                        <Grid>
                            <Border x:Name="Border"
                        CornerRadius="5"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"/>

                            <!-- Inhalt + Dropdown-Button -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Nicht editierbar: zeigt Auswahltext -->
                                <ContentPresenter x:Name="ContentSite"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>

                                <!-- Editierbar: eingebaute TextBox -->
                                <TextBox x:Name="PART_EditableTextBox"
                             Margin="{TemplateBinding Padding}"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalAlignment="Center"
                             Visibility="Hidden"/>

                                <!-- Rechter Button zum Öffnen (schlicht, ohne Extra-Optik) -->
                                <ToggleButton x:Name="ToggleButton"
                                  Grid.Column="1"
                                  Focusable="False"
                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="8,0">
                                    <!-- Einfache Pfeil-Geometrie -->
                                    <Path Data="M 0 0 L 8 0 L 4 4 Z"
                              Width="10"
                              Height="6"
                              Stretch="Uniform"
                              Fill="#666"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                                </ToggleButton>
                            </Grid>

                            <!-- Popup mit Standard-ItemsPresenter, ebenfalls abgerundet -->
                            <Popup x:Name="PART_Popup"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       Focusable="False"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       PopupAnimation="Fade">
                                <Border CornerRadius="5"
                            Margin="0,4,0,0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                                    <ScrollViewer CanContentScroll="True"
                                      VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Minimale Trigger nur für Editierbarkeit (keine Farben/Animationen) -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="153"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- Artikelnummer -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" Margin="5,5,5,5">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Artikelnummer" />
                <TextBox  Text="{Binding Path= Articlenumber, Mode=TwoWay}" Width="200" Height="30" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="10,0,5,0">
                <TextBlock  Text="Weiterverarbeitung"/>
                <ComboBox x:Name="cbxProcess" Width="Auto" Height="30" IsEditable="True">
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="10,0,5,0">
                <TextBlock  Text="Oberfläche"/>
                <ComboBox x:Name="cbxSurface" Width="Auto" Height="30" Text="{Binding Surface, Mode=TwoWay}"  IsEditable="True">
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="10,0,5,0" >
                <TextBlock Text="Lagerplatz"/>
                <TextBox Text="{Binding StorageLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" Height="30" HorizontalAlignment="Left" />
            </StackPanel>

        </StackPanel>


        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Margin="5,5,5,5">
        </StackPanel>

        <!-- Beschreibung -->
        <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="0" Margin="5,5,5,0">
            <TextBlock Text="Beschreibung" />
            <TextBox x:Name="txtDiscription" AcceptsReturn="True" 
                 Height="120" TextWrapping="Wrap"
                 Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>


        <!-- Stückliste -->
        <StackPanel Orientation="Vertical" Grid.Row="2" Grid.Column="0" Margin="5,5,5,5" Grid.RowSpan="2">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <!-- Standardmäßig ausblenden -->
                    <Style.Triggers>
                        <!-- Sichtbar, wenn Eigenfertigung ausgewählt -->
                        <DataTrigger Binding="{Binding ProcurementType, UpdateSourceTrigger=PropertyChanged}"
                         Value="Eigenfertigung">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <StackPanel Orientation="Vertical" >
                <TextBlock Text=  "Fertigungsliste" />
                <DataGrid x:Name="dgBom" AutoGenerateColumns="True" Height="150" VerticalAlignment="Stretch" />
            </StackPanel>

        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="3" Margin="0,5,0,0" >


            <StackPanel  Orientation="Horizontal" Margin="5">


            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" Margin="5,5,0,5" Width="90">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <!-- Standardmäßig ausblenden -->
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <!-- Sichtbar, wenn Eigenfertigung ausgewählt -->
                        <DataTrigger Binding="{Binding Text, ElementName=cbxProcess}" Value="">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Button x:Name="btnSend" Content="Anlegen" Width="80" Click="BtnSend_Click" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" Margin="5,5,0,5" Width="120">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <!-- Standardmäßig sichtbar -->
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <!-- Sichtbar, wenn Eigenfertigung ausgewählt -->
                        <DataTrigger Binding="{Binding Text, ElementName=cbxProcess}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Button x:Name="btnProg" Content="Weiterverarbeiten" Width="110" Click="BtnProg_Click"/>
        </StackPanel>


    </Grid>
</Window>
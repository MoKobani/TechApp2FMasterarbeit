<Page x:Class="PL.Pages.Settings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PL.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- Style für runde Buttons -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF1B1F1F"/>
            <!-- Normal -->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property = "Height" Value="25"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    CornerRadius="5"
                    SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover-Effekt -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF2D2C2C"/>
                                <!-- Hover-Farbe -->
                            </Trigger>

                            <!-- Klick-Effekt -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF2D2C2C"/>
                                <!-- Klick-Farbe -->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style für runde TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="5"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimaler Style: NUR abgerundete Ecken für ComboBox -->
        <Style TargetType="ComboBox">
            <!-- Grundwerte wie bei deiner TextBox -->
            <Setter Property="Padding" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <!-- Äußerer Rahmen mit runden Ecken -->
                        <Grid>
                            <Border x:Name="Border"
                        CornerRadius="5"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"/>

                            <!-- Inhalt + Dropdown-Button -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Nicht editierbar: zeigt Auswahltext -->
                                <ContentPresenter x:Name="ContentSite"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>

                                <!-- Editierbar: eingebaute TextBox -->
                                <TextBox x:Name="PART_EditableTextBox"
                             Margin="{TemplateBinding Padding}"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalAlignment="Center"
                             Visibility="Hidden"/>

                                <!-- Rechter Button zum Öffnen (schlicht, ohne Extra-Optik) -->
                                <ToggleButton x:Name="ToggleButton"
                                  Grid.Column="1"
                                  Focusable="False"
                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="8,0">
                                    <!-- Einfache Pfeil-Geometrie -->
                                    <Path Data="M 0 0 L 8 0 L 4 4 Z"
                              Width="10"
                              Height="6"
                              Stretch="Uniform"
                              Fill="#666"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                                </ToggleButton>
                            </Grid>

                            <!-- Popup mit Standard-ItemsPresenter, ebenfalls abgerundet -->
                            <Popup x:Name="PART_Popup"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       Focusable="False"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       PopupAnimation="Fade">
                                <Border CornerRadius="5"
                            Margin="0,4,0,0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                                    <ScrollViewer CanContentScroll="True"
                                      VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Minimale Trigger nur für Editierbarkeit (keine Farben/Animationen) -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
            <StackPanel>
                <!-- Beispiel: 10 Einträge -->
                <StackPanel Orientation="Horizontal" Margin="0 5">
                    <Label Content="User:" Width="120" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding User}" Width="200"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0 5">
                    <Label Content="Artikelvorlagen:" Width="120" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding TamplatesPath}" Width="500"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0 5">
                    <Label Content="Server IP-Adresse:" Width="120" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding ServerIP}" Width="200"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Margin="0 5">
                    <Label Content="Portnummer:" Width="120" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding PortNumber}" Width="200"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Margin="0 5">
                    <Label Content="Artikel Datenbank:" Width="120" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding DbDescriptor}" Width="200"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="1" Content="Save" Width="100" HorizontalAlignment="Right" Margin="0,10,0,0" Click="BtnSave_Click"/>
    </Grid> 

</Page>
